DATABASE_URL=postgres://nzila:nzila@localhost:5432/nzila
REDIS_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nzila
S3_SECRET_KEY=nzila-dev-only
API_PORT=4000
# The zone: where it listens, and (optionally) the built pack of the district it runs.
ZONE_PORT=2567
# ZONE_PACKS=apps/client/public/packs/l1
# The Estúdio (apps/studio) runs on http://127.0.0.1:5180 with `pnpm dev`. A staff account is made with:
#   pnpm staff:add <email> "<name>" <role>[,<role>]      roles: moderador, live_ops, support, platform_admin
# Talk in the street is open. "off" shuts it on this zone while the game goes on (D-3.8).
# CHAT=off
# Where a phone reaches this zone, as the API hands it out. Empty: the game's own address, at /zone (one proxy in front of both).
ZONE_PUBLIC_URL=
# Development only: lets the swarm and a lone developer into the zone with a session, with no seat from the API.
ZONE_SESSIONS=on

# Development only. Production keys live in the secret store, never in a file in the repository.
# FIELD_KEYS encrypts personal fields: <id>:<base64 of 32 bytes>, comma separated; the highest id is current.
FIELD_KEYS=1:WxZny2LxP/MRddmzhxy3RujihjJPJyBFK5MiuCRnq9A=
# HASH_PEPPER keys the hashes of phone numbers and device ids: base64 of at least 32 bytes.
HASH_PEPPER=jXF8e9n/jkXJJ63AlW3glMCnlxtLQAfVHn7BxAWXGfw=

# Mail (Resend). Without a key, the API prints each letter on its console and sends nothing.
# EMAIL_FROM must be an address on a domain verified in the Resend account.
RESEND_API_KEY=
EMAIL_FROM=Nzila <onboarding@resend.dev>
# Saving a BI with a phone number needs a paid provider to send the codes: off until there is one.
PHONE_CODES=off
