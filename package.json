{
  "name": "nzila",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm services && turbo run dev",
    "dev:client": "pnpm --filter @nzila/client dev",
    "dev:zone": "pnpm --filter @nzila/zone dev",
    "swarm": "node --env-file-if-exists=.env.example --env-file-if-exists=.env tools/swarm/src/run.ts",
    "verify:phase3": "node --env-file-if-exists=.env.example --env-file-if-exists=.env tools/swarm/src/verify.ts",
    "dev:down": "docker compose -f infra/docker-compose.yml down",
    "services": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:migrate": "node packages/db/src/cli.ts migrate",
    "db:seed": "node packages/db/src/cli.ts seed",
    "db:journal": "node packages/db/src/cli.ts journal",
    "ledger:audit": "node packages/db/src/cli.ts audit",
    "staff:add": "node --env-file-if-exists=.env.example --env-file-if-exists=.env apps/api/src/staff-cli.ts",
    "dev:studio": "pnpm --filter @nzila/studio dev",
    "pack:build": "node tools/pack/src/cli.ts build",
    "pack:check": "node tools/pack/src/cli.ts check",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run --project node --coverage",
    "test:engines": "node tools/retry.mjs 2 vitest run --project engines",
    "test:integration": "vitest run --project integration",
    "budget": "node tools/budget/check.mjs",
    "test:quick": "node tools/gate/quick.mjs",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:engines && pnpm test:integration && pnpm pack:check && pnpm pack:bairros && pnpm pack:dev && pnpm build && pnpm budget && pnpm test:e2e",
    "shots": "node tools/shots/shoot.mjs",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "pack:export": "node tools/pack/src/cli.ts export",
    "pack:palette": "node tools/pack/src/dev-pack.ts palette",
    "pack:dev": "node tools/pack/src/dev-pack.ts dev",
    "pack:l1": "node tools/pack/src/dev-pack.ts l1",
    "pack:zango": "node tools/pack/src/dev-pack.ts zango",
    "pack:bairro": "node tools/pack/src/dev-pack.ts",
    "pack:bairros": "node tools/pack/src/dev-pack.ts bairros"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
