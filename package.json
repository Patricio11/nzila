{
  "name": "nzila",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm services && turbo run dev",
    "dev:client": "pnpm --filter @nzila/client dev",
    "dev:down": "docker compose -f infra/docker-compose.yml down",
    "services": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:migrate": "node packages/db/src/cli.ts migrate",
    "db:seed": "node packages/db/src/cli.ts seed",
    "db:journal": "node packages/db/src/cli.ts journal",
    "pack:build": "node tools/pack/src/cli.ts build",
    "pack:check": "node tools/pack/src/cli.ts check",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run --project node --coverage",
    "test:engines": "vitest run --project engines",
    "test:integration": "vitest run --project integration",
    "budget": "node tools/budget/check-shell.mjs",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:engines && pnpm test:integration && pnpm pack:check && pnpm build && pnpm budget"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
